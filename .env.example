# Server Port
PORT=5000
NODE_ENV=development

# Database Connection (Microsoft SQL Server)
# Format for SQL Server Auth (e.g. sa user):
DATABASE_URL="sqlserver://localhost:1433;database=Razmyar;user=sa;password=YourPassword123;encrypt=false;trustServerCertificate=true"

# Format for SQLEXPRESS:
# DATABASE_URL="sqlserver://localhost;instanceName=SQLEXPRESS;database=Razmyar;user=sa;password=YourPassword123;encrypt=false;trustServerCertificate=true"

# JWT Authentication Secret
JWT_SECRET="razmyar_jwt_super_secret_key_2026"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origin
CORS_ORIGIN="http://localhost:3000"
